# Every variable here is a fallback for the matching field of
# `createBacklogAdapter({ ... })`, and the fallbacks apply only to the
# single-space configuration shape. An explicit empty value is a validation
# error rather than a request to fall back, so leave a variable out entirely
# when you do not want it.

# --- Required for a single-space adapter -----------------------------------

# Space host without a scheme, port or path. Backlog spaces also live on
# backlog.jp and on legacy backlogtool.com domains, so this is the full host
# and never a subdomain slug.
BACKLOG_HOST=example.backlog.com

# Personal API key issued from Backlog's Personal Settings -> API. Sent in the
# `Backlog-API-Key` header; never put it in a URL query string.
# Supply this OR BACKLOG_ACCESS_TOKEN, not both.
BACKLOG_API_KEY=your-api-key

# Numeric id of the bot user, used to recognise the adapter's own messages and
# to detect assignment to the bot. This is a number, not the login name --
# `GET /api/v2/users/myself` reports it for the key above.
BACKLOG_BOT_USER_ID=999

# The bot user's display name, exactly as Backlog renders it in a comment.
# Mentions arrive as resolved text (`@Chatbot`), so this is what the mention
# pattern matches; an empty name would make every `@` a mention.
BACKLOG_BOT_USER_NAME=Chatbot

# High-entropy secret carried in the webhook URL's `token` query parameter.
# Backlog signs nothing, so this is the only sender-side check the adapter can
# make -- generate it with `openssl rand -hex 32` and treat it as a credential.
# Required unless the adapter is constructed with a `webhookVerifier`.
BACKLOG_WEBHOOK_SECRET=generate-a-long-random-value

# --- Optional ---------------------------------------------------------------

# OAuth 2.0 bearer token, as an alternative to BACKLOG_API_KEY. Access tokens
# expire after an hour and the adapter performs no OAuth flow, so prefer the
# resolver form of the `accessToken` option for anything long-running.
# BACKLOG_ACCESS_TOKEN=your-access-token

# --- Opt-in live test suite -------------------------------------------------
# The live suite skips itself unless BACKLOG_HOST, BACKLOG_API_KEY and
# BACKLOG_LIVE_ISSUE_ID are all set. It comments on this issue and deletes what
# it created, so point it at a scratch issue, never a real one.
# BACKLOG_LIVE_ISSUE_ID=8001
