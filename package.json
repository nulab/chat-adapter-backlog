{
  "name": "@nulab/chat-adapter-backlog",
  "version": "0.0.0",
  "description": "Backlog adapter for Chat SDK with support for issues, pull requests, comments, and project notifications.",
  "keywords": [
    "nulab",
    "backlog",
    "chat-sdk",
    "adapter"
  ],
  "homepage": "https://github.com/nulab/chat-adapter-backlog#readme",
  "bugs": {
    "url": "https://github.com/nulab/chat-adapter-backlog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulab/chat-adapter-backlog.git"
  },
  "license": "MIT",
  "author": "Nulab Inc.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "only-allow pnpm",
    "prepare": "lefthook install",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tsdown.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "chat": "^4.39.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@chat-adapter/state-memory": "^4.39.0",
    "@chat-adapter/tests": "^4.39.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chat": "^4.39.0",
    "lefthook": "^2.1.12",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.2.1+sha512.f55ca68aacb9eb5ab69c66f828a98af89a32286703aef1f8da131ca7eab4d677f34bfa85e186467a919c0799df8b6f4aa240f7dc2919b33b3273190104162616",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.39.0",
    "backlog-js": "^0.20.1",
    "zod": "^4.5.4"
  }
}
