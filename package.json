{
  "name": "@nulab/chat-adapter-backlog",
  "version": "0.0.0",
  "description": "Backlog adapter for Chat SDK with support for issues, comments, and project notifications.",
  "keywords": [
    "nulab",
    "backlog",
    "chat-sdk",
    "adapter"
  ],
  "homepage": "https://github.com/nulab/chat-adapter-backlog#readme",
  "bugs": {
    "url": "https://github.com/nulab/chat-adapter-backlog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulab/chat-adapter-backlog.git"
  },
  "license": "MIT",
  "author": "Nulab Inc.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tsdown.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "^2.1.12",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
