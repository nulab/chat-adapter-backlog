# Space host, no scheme and no path.
BACKLOG_HOST=example.backlog.com
# API key issued as the bot user.
BACKLOG_API_KEY=
# Required: the bot user's numeric id, not the login userId.
# How to find it: https://github.com/nulab/chat-adapter-backlog/blob/main/README.md#configuration
BACKLOG_BOT_USER_ID=
# High-entropy secret, also present in the hook URL you register in Backlog.
BACKLOG_WEBHOOK_SECRET=
