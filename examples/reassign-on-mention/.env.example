# Space host, no scheme and no path.
BACKLOG_HOST=example.backlog.com
# API key issued as the bot user.
BACKLOG_API_KEY=
# The bot user's numeric id, from GET /api/v2/users/myself.
BACKLOG_BOT_USER_ID=
# The bot user's display name, as Backlog resolves @mentions to it. This bot
# answers mentions, so it needs the name for a typed @name to count.
BACKLOG_BOT_USER_NAME=
# High-entropy secret, also present in the hook URL you register in Backlog.
BACKLOG_WEBHOOK_SECRET=
