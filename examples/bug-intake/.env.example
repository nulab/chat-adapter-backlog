# Read by createBacklogAdapter(); see examples/README.md "Shared setup".
BACKLOG_HOST=example.backlog.com
BACKLOG_API_KEY=
# Required: the bot user's numeric id, not the login userId.
# See the repository README Configuration section for how to find it.
BACKLOG_BOT_USER_ID=
# Required: the bot user's display name.
BACKLOG_BOT_USER_NAME=
BACKLOG_WEBHOOK_SECRET=

# The issue type this bot triages. "Bug" on an English space, "バグ" on a
# Japanese one — it is matched against the type's display name.
BUG_ISSUE_TYPE_NAME=Bug

# The status id that counts as done. 4 is Backlog's default "Closed".
DONE_STATUS_ID=4

# Numeric user id the issue is handed to once it is done.
INTAKE_CONTACT_USER_ID=

# Vercel AI Gateway model string. The default is deliberately a cheap model.
AI_MODEL=openai/gpt-5.4-nano
# Only needed to run this outside Vercel; on Vercel the OIDC token authenticates.
AI_GATEWAY_API_KEY=
