# The space to talk to, and the bot user that does the talking.
BACKLOG_HOST=example.backlog.com
BACKLOG_API_KEY=
# Set this. Left blank, the adapter asks GET /api/v2/users/myself for it on
# every cold start. Read it yourself once instead:
#   curl -H "Backlog-API-Key: $BACKLOG_API_KEY" https://$BACKLOG_HOST/api/v2/users/myself
# and copy the numeric "id" (not the login "userId").
BACKLOG_BOT_USER_ID=
# Required: the "name" from the same response. A close that mentions the bot
# is routed as a mention, and that routing matches this name.
BACKLOG_BOT_USER_NAME=
# The same secret that appears in the hook URL registered in Backlog.
BACKLOG_WEBHOOK_SECRET=

# The status that counts as closed. "4" is Backlog's default id for 完了/Done.
DONE_STATUS_ID=4
# The numeric id of the custom field that must be filled in before closing.
REQUIRED_CUSTOM_FIELD_ID=
