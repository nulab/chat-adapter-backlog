{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Nothing here emits -- tsdown builds, and the `typecheck` script is
    // `tsc --noEmit`. `declarationMap` looks like the switch for whether a
    // published `.d.ts` carries a `sourceMappingURL` comment; it is not (disproved
    // while fixing #107, which shipped `declarationMap`/`tsgo` as the cause
    // first and had to correct it). Every build entry in tsdown.config.ts sets
    // `dts: { sourcemap: false }` itself, and an explicit value there always
    // wins over rolldown-plugin-dts's fallback to this field, so it is inert
    // for the build either way. What actually decides the comment is explained
    // next to the two build entries in tsdown.config.ts. This stays `true`
    // only as `declaration`'s conventional companion, for a tool that reads
    // this file directly rather than going through tsdown.
    "declaration": true,
    "declarationMap": true,
    "noEmit": true
  },
  "include": ["src/**/*", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
