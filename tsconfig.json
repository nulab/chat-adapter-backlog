{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // No `declarationMap`: rolldown-plugin-dts falls back to it for
    // `dts.sourcemap`, and a `.d.ts.map` could only point at `src/`, which
    // `files` does not ship.
    "declaration": true,
    "noEmit": true
  },
  "include": ["src/**/*", "scripts/check-published-types.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
