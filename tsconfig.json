{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Nothing here emits -- tsdown builds, and the `typecheck` script is
    // `tsc --noEmit`. `declarationMap` is inert for the build: every entry in
    // tsdown.config.ts sets `dts.sourcemap` itself, which always wins over
    // rolldown-plugin-dts's fallback to this field -- see tsdown.config.ts
    // for what actually decides a published `.d.ts`'s `sourceMappingURL`.
    "declaration": true,
    "declarationMap": true,
    "noEmit": true
  },
  "include": ["src/**/*", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
